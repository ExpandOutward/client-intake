PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/intake.db

# On Render, leave DATABASE_PATH unset and use the linked Postgres URL instead:
# DATABASE_URL=

# Make.com custom webhook URL. Leave empty to skip outbound calls locally.
MAKE_WEBHOOK_URL=

# Required to change request status via PATCH /api/requests/:id
ADMIN_KEY=

# When set, the public intake form requires this password (httpOnly cookie).
SITE_PASSWORD=

# Shown on the login screen so people can request a demo login.
CONTACT_EMAIL=
